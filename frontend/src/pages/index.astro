---
import Layout from '../layouts/Layout.astro';

const playerTools = [
  { name: 'Species', href: '/species.html', icon: '🧝', desc: 'Browse all playable species and races' },
  { name: 'Classes', href: '/classes.html', icon: '⚔️', desc: 'Explore class features and subclasses' },
  { name: 'Feats', href: '/feats.html', icon: '✨', desc: 'Find and filter feats by source' },
  { name: 'Options & Features', href: '/optionalfeatures.html', icon: '🎯', desc: 'Class options and eldritch invocations' },
  { name: 'Backgrounds', href: '/backgrounds.html', icon: '📜', desc: 'Character backstory and starting gear' },
  { name: 'Items', href: '/items.html', icon: '🗡️', desc: 'Weapons, armor, and magic items' },
  { name: 'Spells', href: '/spells.html', icon: '🔮', desc: 'Full spell compendium with filters' },
  { name: 'Stat Generator', href: '/statgen.html', icon: '🎲', desc: 'Roll or point-buy your ability scores' },
];

const rulesTools = [
  { name: 'Adventures', href: '/adventures.html', icon: '🗺️', desc: 'Published adventure modules' },
  { name: 'Books', href: '/books.html', icon: '📚', desc: 'Core rulebooks and supplements' },
  { name: 'Rules Glossary', href: '/rulesglossary.html', icon: '📖', desc: 'Quick-reference rules definitions' },
  { name: 'Conditions', href: '/conditionsdiseases.html', icon: '💀', desc: 'Status effects and diseases' },
];

const dmTools = [
  { name: 'Bestiary', href: '/bestiary.html', icon: '🐉', desc: 'Complete monster manual with filters' },
  { name: 'DM Screen', href: '/dmscreen.html', icon: '🛡️', desc: 'In-session reference panels' },
  { name: 'Loot Generator', href: '/lootgen.html', icon: '💰', desc: 'Random treasure and loot tables' },
  { name: 'CR Calculator', href: '/crcalculator.html', icon: '⚖️', desc: 'Balance encounter difficulty' },
];

const navLinks = [
  { label: 'Species', href: '/species.html' },
  { label: 'Classes', href: '/classes.html' },
  { label: 'Spells', href: '/spells.html' },
  { label: 'Items', href: '/items.html' },
  { label: 'Bestiary', href: '/bestiary.html' },
  { label: 'Rules', href: '/rulesglossary.html' },
];
---

<Layout title="E5etools — 5th Edition D&D Tools">
  <!-- NAV -->
  <header style="background:#0f0d0b; border-bottom:1px solid #2e2820; position:sticky; top:0; z-index:50;">
    <div style="max-width:1200px; margin:0 auto; padding:0 1.5rem; display:flex; align-items:center; justify-content:space-between; height:3.5rem;">
      <a href="/" style="font-family:'Cinzel',serif; font-size:1.25rem; font-weight:700; color:#c9a84c; text-decoration:none; letter-spacing:0.05em;">
        E5etools
      </a>
      <nav style="display:flex; gap:1.5rem; align-items:center;">
        {navLinks.map(link => (
          <a href={link.href} style="color:#8a7a6a; font-size:0.875rem; text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section style="position:relative; overflow:hidden; padding:6rem 1.5rem 5rem; text-align:center; background:linear-gradient(180deg, #1a1208 0%, #0f0d0b 100%);">
    <!-- decorative radial glow -->
    <div style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:600px; height:400px; background:radial-gradient(ellipse at center, rgba(201,168,76,0.12) 0%, transparent 70%); pointer-events:none;"></div>
    <!-- decorative top border line -->
    <div style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, transparent, #c9a84c, transparent);"></div>

    <div style="position:relative; max-width:800px; margin:0 auto;">
      <div style="display:inline-block; border:1px solid rgba(201,168,76,0.3); border-radius:2rem; padding:0.25rem 1rem; margin-bottom:1.5rem; font-size:0.75rem; color:#8a7a6a; letter-spacing:0.1em; text-transform:uppercase;">
        Community Fork
      </div>
      <h1 style="font-family:'Cinzel',serif; font-size:clamp(2.5rem,7vw,5rem); font-weight:900; color:#e8dcc8; line-height:1.1; margin:0 0 1.25rem; letter-spacing:0.03em;">
        E5e<span style="color:#c9a84c;">tools</span>
      </h1>
      <p style="font-size:clamp(1rem,2vw,1.25rem); color:#8a7a6a; max-width:600px; margin:0 auto 2.5rem; line-height:1.7;">
        A suite of tools for 5th Edition Dungeons &amp; Dragons players and Dungeon Masters.
      </p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/spells.html" style="background:#c9a84c; color:#0f0d0b; font-weight:600; padding:0.75rem 2rem; border-radius:0.375rem; text-decoration:none; font-size:0.9375rem; transition:opacity 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
          Browse Spells
        </a>
        <a href="/bestiary.html" style="background:transparent; color:#c9a84c; font-weight:600; padding:0.75rem 2rem; border-radius:0.375rem; text-decoration:none; font-size:0.9375rem; border:1px solid #c9a84c; transition:background 0.2s;" onmouseover="this.style.background='rgba(201,168,76,0.1)'" onmouseout="this.style.background='transparent'">
          Open Bestiary
        </a>
      </div>
    </div>
  </section>

  <!-- TOOL GROUPS -->
  <main style="max-width:1200px; margin:0 auto; padding:3rem 1.5rem 5rem;">

    <!-- PLAYERS -->
    <section style="margin-bottom:4rem;">
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.75rem;">
        <span style="width:3px; height:1.5rem; background:#4a9eff; border-radius:2px; display:inline-block;"></span>
        <h2 style="font-family:'Cinzel',serif; font-size:1.5rem; font-weight:700; color:#e8dcc8; margin:0;">Players</h2>
        <span style="height:1px; flex:1; background:linear-gradient(90deg, #2e2820, transparent);"></span>
      </div>
      <div class="tool-grid">
        {playerTools.map(tool => (
          <a href={tool.href} class="tool-card tool-card--player">
            <span class="tool-icon">{tool.icon}</span>
            <span class="tool-name">{tool.name}</span>
            <span class="tool-desc">{tool.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- RULES -->
    <section style="margin-bottom:4rem;">
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.75rem;">
        <span style="width:3px; height:1.5rem; background:#a855f7; border-radius:2px; display:inline-block;"></span>
        <h2 style="font-family:'Cinzel',serif; font-size:1.5rem; font-weight:700; color:#e8dcc8; margin:0;">Rules</h2>
        <span style="height:1px; flex:1; background:linear-gradient(90deg, #2e2820, transparent);"></span>
      </div>
      <div class="tool-grid">
        {rulesTools.map(tool => (
          <a href={tool.href} class="tool-card tool-card--rules">
            <span class="tool-icon">{tool.icon}</span>
            <span class="tool-name">{tool.name}</span>
            <span class="tool-desc">{tool.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- DM TOOLS -->
    <section style="margin-bottom:4rem;">
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.75rem;">
        <span style="width:3px; height:1.5rem; background:#ef4444; border-radius:2px; display:inline-block;"></span>
        <h2 style="font-family:'Cinzel',serif; font-size:1.5rem; font-weight:700; color:#e8dcc8; margin:0;">Dungeon Masters</h2>
        <span style="height:1px; flex:1; background:linear-gradient(90deg, #2e2820, transparent);"></span>
      </div>
      <div class="tool-grid">
        {dmTools.map(tool => (
          <a href={tool.href} class="tool-card tool-card--dm">
            <span class="tool-icon">{tool.icon}</span>
            <span class="tool-name">{tool.name}</span>
            <span class="tool-desc">{tool.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- INFO CARDS -->
    <section>
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.75rem;">
        <span style="width:3px; height:1.5rem; background:#c9a84c; border-radius:2px; display:inline-block;"></span>
        <h2 style="font-family:'Cinzel',serif; font-size:1.5rem; font-weight:700; color:#e8dcc8; margin:0;">Resources</h2>
        <span style="height:1px; flex:1; background:linear-gradient(90deg, #2e2820, transparent);"></span>
      </div>
      <div class="info-grid">
        <div class="info-card">
          <div class="info-icon">💬</div>
          <h3 class="info-title">Discord</h3>
          <p class="info-body">Join the community on Discord for help, homebrew discussion, and announcements.</p>
          <a href="https://discord.gg/5etools" class="info-link">Join Discord →</a>
        </div>
        <div class="info-card">
          <div class="info-icon">🎲</div>
          <h3 class="info-title">Foundry VTT</h3>
          <p class="info-body">Use the Plutonium module to integrate E5etools content directly into Foundry VTT.</p>
          <a href="https://foundryvtt.com/" class="info-link">Learn more →</a>
        </div>
        <div class="info-card">
          <div class="info-icon">🌐</div>
          <h3 class="info-title">Roll20</h3>
          <p class="info-body">The Rivet browser extension brings E5etools content into your Roll20 campaigns.</p>
          <a href="https://roll20.net/" class="info-link">Learn more →</a>
        </div>
        <div class="info-card">
          <div class="info-icon">❓</div>
          <h3 class="info-title">FAQ</h3>
          <p class="info-body">Questions about sources, content, or how the tools work? Check the FAQ first.</p>
          <a href="/faq.html" class="info-link">Read FAQ →</a>
        </div>
        <div class="info-card">
          <div class="info-icon">🖥️</div>
          <h3 class="info-title">Self-Hosting</h3>
          <p class="info-body">Run E5etools locally or on your own server. Full instructions on the wiki.</p>
          <a href="https://github.com/5etools-mirror-3/5etools-src/wiki/Self-Hosting" class="info-link">See guide →</a>
        </div>
        <div class="info-card">
          <div class="info-icon">⚠️</div>
          <h3 class="info-title">Disclaimer</h3>
          <p class="info-body">E5etools is an unofficial fan project. Content is sourced from published materials for reference.</p>
          <a href="/privacy-policy.html" class="info-link">Privacy Policy →</a>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer style="border-top:1px solid #2e2820; background:#0a0906; padding:2rem 1.5rem; text-align:center;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="font-family:'Cinzel',serif; font-size:1rem; color:#c9a84c; margin:0 0 0.5rem; font-weight:600;">E5etools</p>
      <p style="color:#8a7a6a; font-size:0.8125rem; margin:0 0 1rem;">
        Version <span id="version-placeholder">2.x</span> &mdash; An unofficial community fork of 5etools
      </p>
      <div style="display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap;">
        <a href="/privacy-policy.html" style="color:#8a7a6a; font-size:0.8125rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Privacy Policy</a>
        <a href="/faq.html" style="color:#8a7a6a; font-size:0.8125rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">FAQ</a>
        <a href="https://discord.gg/5etools" style="color:#8a7a6a; font-size:0.8125rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Discord</a>
      </div>
      <p style="color:#3a342c; font-size:0.75rem; margin:1.25rem 0 0;">
        D&amp;D content is the property of Wizards of the Coast. Not affiliated with or endorsed by WotC.
      </p>
    </div>
  </footer>
</Layout>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.875rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    background: #1a1612;
    border: 1px solid #2e2820;
    border-radius: 0.5rem;
    padding: 1.125rem 1.25rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
    cursor: pointer;
  }

  .tool-card:hover {
    background: #221e18;
    transform: translateY(-2px);
  }

  .tool-card--player:hover { border-color: #4a9eff; }
  .tool-card--rules:hover  { border-color: #a855f7; }
  .tool-card--dm:hover     { border-color: #ef4444; }

  .tool-icon {
    font-size: 1.375rem;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .tool-name {
    font-family: 'Cinzel', serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #e8dcc8;
    line-height: 1.3;
  }

  .tool-desc {
    font-size: 0.75rem;
    color: #8a7a6a;
    line-height: 1.4;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: #1a1612;
    border: 1px solid #2e2820;
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .info-card:hover {
    background: #221e18;
    border-color: rgba(201,168,76,0.35);
  }

  .info-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .info-title {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #e8dcc8;
    margin: 0 0 0.5rem;
  }

  .info-body {
    font-size: 0.875rem;
    color: #8a7a6a;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .info-link {
    font-size: 0.8125rem;
    color: #c9a84c;
    text-decoration: none;
    font-weight: 500;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
