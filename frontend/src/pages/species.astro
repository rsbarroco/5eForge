---
import Layout from '../layouts/Layout.astro';
import speciesData from '../data/species.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Collect all unique trait names for the filter
const allTraits = [...new Set(speciesData.flatMap(s => s.traitNames))].sort();

const SOURCE_LABEL: Record<string, string> = {
  XPHB: "2024 PHB", MPMM: "Mordenkainen's", PHB: "Player's Handbook",
  VGM: "Volo's Guide", MTF: "Mordenkainen's ToF", ERLW: "Eberron",
  AAG: "Spelljammer", GGR: "Ravnica", MOT: "Theros", SCC: "Strixhaven",
  FTD: "Fizban's Treasury", TCE: "Tasha's", DMG: "Dungeon Master's Guide",
  EEPC: "Elemental Evil", TTP: "Tortle Package", LR: "Locathah Rising",
  OGA: "One Grung Above", AI: "Acquisitions Inc", WBtW: "Wild Beyond the Witchlight",
  EFA: "Eberron (Legacy)", VRGR: "Van Richten's Guide",
};
---

<Layout title="Species — 5eForge" description="Browse all playable species with unified traits and modular filtering.">

  <!-- NAV -->
  <header style="background:#0f0d0b; border-bottom:1px solid #2e2820; position:sticky; top:0; z-index:50;">
    <div style="max-width:1400px; margin:0 auto; padding:0 1.5rem; display:flex; align-items:center; justify-content:space-between; height:3.5rem;">
      <a href={`${base}/`} style="font-family:'Cinzel',serif; font-size:1.25rem; font-weight:700; color:#c9a84c; text-decoration:none; letter-spacing:0.05em;">
        5e<span style="color:#e8dcc8;">Forge</span>
      </a>
      <nav style="display:flex; gap:1.5rem; align-items:center;">
        <a href={`${base}/`} style="color:#8a7a6a; font-size:0.875rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Home</a>
        <a href={`${base}/species`} style="color:#c9a84c; font-size:0.875rem; text-decoration:none; font-weight:600;">Species</a>
        <a href={`${base}/classes.html`} style="color:#8a7a6a; font-size:0.875rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Classes</a>
        <a href={`${base}/spells.html`} style="color:#8a7a6a; font-size:0.875rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Spells</a>
        <a href={`${base}/bestiary.html`} style="color:#8a7a6a; font-size:0.875rem; text-decoration:none;" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8a7a6a'">Bestiary</a>
      </nav>
    </div>
  </header>

  <!-- PAGE HEADER -->
  <div style="background:linear-gradient(180deg,#1a1208 0%,#0f0d0b 100%); border-bottom:1px solid #2e2820; padding:2.5rem 1.5rem 2rem; position:relative; overflow:hidden;">
    <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:600px;height:200px;background:radial-gradient(ellipse at center,rgba(74,158,255,0.08) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#4a9eff,transparent);"></div>
    <div style="max-width:1400px; margin:0 auto; position:relative;">
      <div style="display:flex; align-items:baseline; gap:1rem; flex-wrap:wrap;">
        <h1 style="font-family:'Cinzel',serif; font-size:2rem; font-weight:900; color:#e8dcc8; margin:0; letter-spacing:0.03em;">
          Species
        </h1>
        <span id="species-count" style="color:#8a7a6a; font-size:0.9rem;"></span>
      </div>
      <p style="color:#8a7a6a; margin:0.5rem 0 0; font-size:0.9rem;">
        Official species with unified, modular traits. Use the filters to find your perfect ancestry.
      </p>
    </div>
  </div>

  <div style="max-width:1400px; margin:0 auto; padding:1.5rem; display:flex; gap:1.5rem; align-items:flex-start;">

    <!-- SIDEBAR FILTERS -->
    <aside id="filter-sidebar" style="width:220px; flex-shrink:0; position:sticky; top:4.5rem; max-height:calc(100vh - 5rem); overflow-y:auto;">
      <div style="background:#1a1612; border:1px solid #2e2820; border-radius:0.5rem; padding:1.25rem;">

        <!-- Search -->
        <div style="margin-bottom:1.25rem;">
          <label style="display:block; font-family:'Cinzel',serif; font-size:0.75rem; color:#8a7a6a; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:0.5rem;">Search</label>
          <input id="search-input" type="text" placeholder="Search species…"
            style="width:100%; background:#0f0d0b; border:1px solid #2e2820; border-radius:0.375rem; padding:0.5rem 0.75rem; color:#e8dcc8; font-size:0.875rem; outline:none; box-sizing:border-box;"
            onfocus="this.style.borderColor='#4a9eff'" onblur="this.style.borderColor='#2e2820'" />
        </div>

        <!-- Size filter -->
        <div style="margin-bottom:1.25rem;">
          <label style="display:block; font-family:'Cinzel',serif; font-size:0.75rem; color:#8a7a6a; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:0.5rem;">Size</label>
          <div style="display:flex; flex-wrap:wrap; gap:0.375rem;">
            {['Small','Medium','Large','Varies'].map(s => (
              <button class="size-filter" data-size={s}
                style="background:#0f0d0b; border:1px solid #2e2820; border-radius:0.25rem; padding:0.25rem 0.625rem; color:#8a7a6a; font-size:0.75rem; cursor:pointer;">
                {s}
              </button>
            ))}
          </div>
        </div>

        <!-- Trait filters -->
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <label style="font-family:'Cinzel',serif; font-size:0.75rem; color:#8a7a6a; letter-spacing:0.08em; text-transform:uppercase;">Traits</label>
            <button id="clear-traits" style="background:none; border:none; color:#c9a84c; font-size:0.7rem; cursor:pointer; padding:0; display:none;">Clear</button>
          </div>
          <div style="display:flex; flex-direction:column; gap:0.25rem;">
            {allTraits.map(trait => (
              <label class="trait-filter-label" style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; padding:0.2rem 0.25rem; border-radius:0.25rem;">
                <input type="checkbox" class="trait-checkbox" data-trait={trait}
                  style="accent-color:#4a9eff; cursor:pointer; width:14px; height:14px; flex-shrink:0;" />
                <span style="font-size:0.775rem; color:#8a7a6a; line-height:1.3;">{trait}</span>
              </label>
            ))}
          </div>
        </div>

      </div>
    </aside>

    <!-- MAIN GRID -->
    <main style="flex:1; min-width:0;">
      <div id="species-grid" class="species-grid">
        {speciesData.map(species => (
          <div
            class="species-card"
            data-name={species.name.toLowerCase()}
            data-size={species.size}
            data-traits={JSON.stringify(species.traitNames)}
          >
            <!-- Card header -->
            <div class="species-card__header">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">
                <h2 class="species-card__name">{species.name}</h2>
                <span class="species-card__source">{SOURCE_LABEL[species.source] ?? species.source}</span>
              </div>
              <div style="display:flex; gap:1rem; margin-top:0.375rem;">
                <span class="species-meta"><span class="meta-label">Size</span> {species.size}</span>
                <span class="species-meta"><span class="meta-label">Speed</span> {species.speed}</span>
              </div>
            </div>

            <!-- Trait tags -->
            <div class="species-card__traits">
              {species.traitNames.map(t => (
                <span class="trait-tag">{t}</span>
              ))}
            </div>

            <!-- Trait details (collapsible) -->
            <details class="species-card__details">
              <summary style="cursor:pointer; color:#c9a84c; font-size:0.8rem; font-weight:500; padding:0.25rem 0; list-style:none; display:flex; align-items:center; gap:0.375rem;">
                <span class="details-arrow">▶</span> Trait details
              </summary>
              <div class="trait-list">
                {species.traits.map(t => (
                  <div class="trait-entry">
                    <span class="trait-entry__name">{t.name}</span>
                    <span class="trait-entry__desc">{t.desc}</span>
                  </div>
                ))}
              </div>
            </details>
          </div>
        ))}
      </div>

      <div id="no-results" style="display:none; text-align:center; padding:4rem 2rem; color:#8a7a6a;">
        <div style="font-size:2rem; margin-bottom:1rem;">🔍</div>
        <p style="font-family:'Cinzel',serif; font-size:1.1rem; color:#e8dcc8; margin:0 0 0.5rem;">No species found</p>
        <p style="font-size:0.875rem; margin:0;">Try adjusting your filters.</p>
      </div>
    </main>
  </div>

  <!-- FOOTER -->
  <footer style="border-top:1px solid #2e2820; background:#0a0906; padding:2rem 1.5rem; text-align:center; margin-top:3rem;">
    <p style="font-family:'Cinzel',serif; font-size:1rem; color:#c9a84c; margin:0 0 0.375rem; font-weight:700;">5e<span style="color:#e8dcc8;">Forge</span></p>
    <p style="color:#8a7a6a; font-size:0.8125rem; margin:0;">Built by <a href="https://github.com/rsbarroco" style="color:#c9a84c; text-decoration:none;">Rodrigo Barroco</a></p>
  </footer>

</Layout>

<style>
  .species-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .species-card {
    background: #1a1612;
    border: 1px solid #2e2820;
    border-radius: 0.5rem;
    padding: 1.125rem 1.25rem;
    transition: border-color 0.2s, background 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .species-card:hover {
    background: #221e18;
    border-color: #4a9eff;
  }

  .species-card__header {}

  .species-card__name {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #e8dcc8;
    margin: 0;
    line-height: 1.3;
  }

  .species-card__source {
    font-size: 0.7rem;
    color: #5a4e42;
    background: #0f0d0b;
    border: 1px solid #2e2820;
    border-radius: 0.25rem;
    padding: 0.15rem 0.4rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .species-meta {
    font-size: 0.775rem;
    color: #8a7a6a;
  }

  .meta-label {
    color: #5a4e42;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 0.25rem;
  }

  .species-card__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .trait-tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    background: #0f0d0b;
    border: 1px solid #2e2820;
    border-radius: 0.25rem;
    color: #8a7a6a;
    transition: border-color 0.15s, color 0.15s;
  }

  .trait-tag.active {
    border-color: #4a9eff;
    color: #4a9eff;
    background: rgba(74,158,255,0.08);
  }

  .species-card__details {
    border-top: 1px solid #2e2820;
    padding-top: 0.625rem;
  }

  .species-card__details[open] .details-arrow {
    transform: rotate(90deg);
    display: inline-block;
  }

  .details-arrow {
    font-size: 0.6rem;
    display: inline-block;
    transition: transform 0.15s;
  }

  .trait-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.625rem;
  }

  .trait-entry {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .trait-entry__name {
    font-family: 'Cinzel', serif;
    font-size: 0.775rem;
    font-weight: 600;
    color: #c9a84c;
  }

  .trait-entry__desc {
    font-size: 0.775rem;
    color: #8a7a6a;
    line-height: 1.5;
  }

  .size-filter.active {
    background: rgba(74,158,255,0.12);
    border-color: #4a9eff;
    color: #4a9eff;
  }

  .trait-filter-label:hover span {
    color: #e8dcc8;
  }

  @media (max-width: 768px) {
    #filter-sidebar {
      display: none;
    }
    .species-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.species-card'));
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const countEl = document.getElementById('species-count');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-traits') as HTMLButtonElement;
  const sizeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.size-filter'));
  const traitCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.trait-checkbox'));

  let selectedSizes: Set<string> = new Set();
  let selectedTraits: Set<string> = new Set();

  function highlight(card: HTMLElement, activeTraits: Set<string>) {
    card.querySelectorAll<HTMLElement>('.trait-tag').forEach(tag => {
      if (activeTraits.has(tag.textContent ?? '')) {
        tag.classList.add('active');
      } else {
        tag.classList.remove('active');
      }
    });
  }

  function filter() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    cards.forEach(card => {
      const name = card.dataset.name ?? '';
      const size = card.dataset.size ?? '';
      const traits: string[] = JSON.parse(card.dataset.traits ?? '[]');

      const matchSearch = !query || name.includes(query);
      const matchSize = selectedSizes.size === 0 || [...selectedSizes].some(s => size.includes(s));
      const matchTraits = selectedTraits.size === 0 || [...selectedTraits].every(t => traits.includes(t));

      const show = matchSearch && matchSize && matchTraits;
      card.style.display = show ? '' : 'none';
      if (show) {
        visible++;
        highlight(card, selectedTraits);
      }
    });

    if (countEl) countEl.textContent = `${visible} species`;
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  // Init count
  if (countEl) countEl.textContent = `${cards.length} species`;

  searchInput.addEventListener('input', filter);

  sizeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const s = btn.dataset.size ?? '';
      if (selectedSizes.has(s)) {
        selectedSizes.delete(s);
        btn.classList.remove('active');
      } else {
        selectedSizes.add(s);
        btn.classList.add('active');
      }
      filter();
    });
  });

  traitCheckboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      const t = cb.dataset.trait ?? '';
      if (cb.checked) {
        selectedTraits.add(t);
      } else {
        selectedTraits.delete(t);
      }
      clearBtn.style.display = selectedTraits.size > 0 ? 'block' : 'none';
      filter();
    });
  });

  clearBtn.addEventListener('click', () => {
    selectedTraits.clear();
    traitCheckboxes.forEach(cb => cb.checked = false);
    clearBtn.style.display = 'none';
    filter();
  });
</script>
